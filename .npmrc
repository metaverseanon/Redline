auto-install-peers=false
strict-peer-dependencies=false
# Flatten node_modules so React Native's Metro bundler can find transitive deps.
# Metro doesn't traverse pnpm's .pnpm/ symlink structure, so the redline Expo app
# requires hoisted layout. Other artifacts (Node API server, Vite preview) are
# unaffected by this layout change.
shamefully-hoist=true
